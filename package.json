{
  "name": "isshoni-hatarakou",
  "productName": "Isshoni Hatarakou",
  "version": "0.1.0",
  "private": true,
  "description": "친구에게 선물하는 데스크톱 작업 메이트",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . && node scripts/check-imports.ts",
    "test": "vitest run",
    "rules:build": "node --no-warnings rules/build.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run rules:build -- --check",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "e2e": "electron-vite build --mode e2e && playwright test",
    "test:emulator": "firebase emulators:exec --project demo-isshoni --only database,auth \"vitest run rules/tests tests/adapter-contract src/modules/*/rules.test.ts\"",
    "account:create": "node --no-warnings scripts/create-account.ts",
    "rules:deploy": "npm run rules:build -- --check && node --no-warnings scripts/deploy-rules.ts"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "get-windows": "9.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "firebase-tools": "15.30.2",
    "globals": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "get-windows@9.3.0": true,
    "@firebase/util": false,
    "protobufjs": false,
    "electron-winstaller": false,
    "re2": false,
    "fsevents": false
  }
}
